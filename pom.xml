<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Never published. The package version is pubspec.yaml's, read by tool/package.sh. -->
    <groupId>org.fuin.sokar</groupId>
    <artifactId>sokar-frontend</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>sokar-frontend</name>
    <description>The Sokar interface. Maven drives Flutter so an end-to-end run can lease a machine.</description>

    <!-- The same licence as the rest of Sokar; the text is in LICENSE. -->
    <licenses>
        <license>
            <name>GPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Which device flutter builds for at "package". Override with -Dflutter.target. -->
        <flutter.target>linux</flutter.target>
        <!-- Declared so -DskipTests resolves here as it does for surefire. -->
        <skipTests>false</skipTests>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <!-- Sokar's BOM names every tool's version; this is the one to bump. -->
        <sokar.version>0.1.0-SNAPSHOT</sokar.version>
    </properties>

    <build>
        <plugins>
            <!-- Flutter and dart from PATH, with no profile around them: nothing here builds without
                 Flutter, and a profile that switched itself off would make a green build that did nothing. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>flutter-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>clean</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-pub-get</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>pub</argument>
                                <argument>get</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- dart, never flutter analyze, which rewrites analysis_options.yaml. Before the
                         build rather than after it: failing early is worth leaving the template's order. -->
                    <execution>
                        <id>dart-analyze</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>dart</executable>
                            <arguments>
                                <argument>analyze</argument>
                                <argument>--fatal-infos</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- The file reporter feeds the build's summary; the console keeps its own output. -->
                    <execution>
                        <id>flutter-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>test</argument>
                                <argument>--file-reporter=json:build/test-results.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>build</argument>
                                <argument>${flutter.target}</argument>
                                <argument>--release</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Against the machine SOKAR_E2E_* names. Failsafe's shape: the run never fails its phase, so
             whatever follows it still runs, and verify fails the build from the status it left. -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>e2e-run</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>mkdir -p build; tool/e2e.sh --file-reporter=json:build/e2e-results.json; echo $? &gt; build/e2e.status</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>e2e-verdict</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>exit "$(cat build/e2e.status)"</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- A machine leased for the run and swept after it, whether the tests passed or not. With
             e2e: ./mvnw verify -Pe2e,hetzner, HETZNER_API set, and the key as HETZNER_SSH (CI) or a
             file named by HETZNER_KEY (a person). Only here, so no other build fetches the tool. -->
        <profile>
            <id>hetzner</id>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>org.fuin.sokar</groupId>
                        <artifactId>sokar-bom</artifactId>
                        <version>${sokar.version}</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>org.fuin.sokar</groupId>
                    <artifactId>sokar-machines</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <!-- Its own JVM, so the tool's exit cannot take Maven down with it. The
                                 classpath arrives as $0; with HETZNER_SSH set the tool needs no key file. -->
                            <execution>
                                <id>hetzner-lease</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>test -z "$HETZNER_KEY" || set -- --key "$HETZNER_KEY"; exec java -classpath "$0" org.fuin.sokar.machines.Main lease --os ubuntu "$@" --write build/leased.properties</argument>
                                        <classpath/>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>hetzner-sweep</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>org.fuin.sokar.machines.Main</argument>
                                        <argument>sweep</argument>
                                        <argument>--from</argument>
                                        <argument>build/leased.properties</argument>
                                        <argument>--now</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Only once the sweep has worked: a failed sweep leaves the file for a
                                 person, and a swept one must not be read as a machine still there. -->
                            <execution>
                                <id>hetzner-done</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>mv -f build/leased.properties build/leased.swept</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
